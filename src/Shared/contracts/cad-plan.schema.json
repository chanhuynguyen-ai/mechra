{
  "$defs": {
    "CadOperation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "create_plate",
            "modify_plate_thickness"
          ],
          "title": "Kind",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "intent",
        "inputs"
      ],
      "title": "CadOperation",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "create_plate"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "additionalProperties": false,
                "properties": {
                  "width_mm": {
                    "exclusiveMinimum": 0,
                    "maximum": 10000,
                    "title": "Width Mm",
                    "type": "number"
                  },
                  "height_mm": {
                    "exclusiveMinimum": 0,
                    "maximum": 10000,
                    "title": "Height Mm",
                    "type": "number"
                  },
                  "thickness_mm": {
                    "exclusiveMinimum": 0,
                    "maximum": 10000,
                    "title": "Thickness Mm",
                    "type": "number"
                  },
                  "plane": {
                    "const": "first_reference_plane",
                    "default": "first_reference_plane",
                    "title": "Plane",
                    "type": "string"
                  }
                },
                "required": [
                  "width_mm",
                  "height_mm",
                  "thickness_mm"
                ],
                "title": "PlateInputs",
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify_plate_thickness"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "additionalProperties": false,
                "properties": {
                  "thickness_mm": {
                    "exclusiveMinimum": 0,
                    "maximum": 10000,
                    "title": "Thickness Mm",
                    "type": "number"
                  },
                  "feature_name": {
                    "const": "Mechra-Plate-Extrude",
                    "default": "Mechra-Plate-Extrude",
                    "title": "Feature Name",
                    "type": "string"
                  }
                },
                "required": [
                  "thickness_mm"
                ],
                "title": "ThicknessInputs",
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Version",
      "type": "string"
    },
    "document_type": {
      "const": "part",
      "default": "part",
      "title": "Document Type",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "requires_confirmation": {
      "const": true,
      "default": true,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/CadOperation"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "operations"
  ],
  "title": "CadPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechra.local/contracts/cad-plan.schema.json"
}
