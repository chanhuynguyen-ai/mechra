{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/contracts/design-spec.schema.json",
  "title": "DesignSpec",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "const": "0.1" },
    "source": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "field", "status", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "field": { "type": "string" },
          "value": {},
          "unit": { "type": ["string", "null"] },
          "status": {
            "enum": ["confirmed", "inferred", "assumed", "missing", "ambiguous", "conflicting"]
          },
          "source": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "required_for": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
